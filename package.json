{
  "name": "simple-office-suite",
  "version": "1.0.0",
  "description": "Lightweight, cross-platform, offline-first productivity suite built with Tauri 2.0 and Svelte",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:installers": "npm run build && npx tauri build && python3 scripts/package_all.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.453.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.11.5",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.7.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "keywords": [
    "office",
    "word-processor",
    "spreadsheet",
    "presentation",
    "tauri",
    "svelte",
    "offline-first",
    "cross-platform"
